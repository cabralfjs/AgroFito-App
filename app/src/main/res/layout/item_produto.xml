<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:background="@color/paper"
    android:padding="12dp" android:layout_marginHorizontal="8dp"
    android:layout_marginTop="5dp" android:elevation="1dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/tv_estado_prod" android:layout_width="20dp"
            android:layout_height="wrap_content" android:textSize="14sp"/>
        <TextView android:id="@+id/tv_designacao" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:textSize="14sp" android:textStyle="bold" android:textColor="@color/blue_dark"
            android:layout_marginStart="4dp"/>
        <TextView android:id="@+id/tv_mpb" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text=" MPB "
            android:textSize="9sp" android:textColor="@color/green"
            android:background="@color/tag_bg" android:visibility="gone"/>
    </LinearLayout>
    <TextView android:id="@+id/tv_substancia_prod" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textSize="12sp"
        android:textColor="@color/muted" android:layout_marginTop="4dp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="3dp">
        <TextView android:id="@+id/tv_titular" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:textSize="10sp" android:textColor="@color/muted"/>
        <TextView android:id="@+id/tv_funcao_prod" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="10sp"
            android:textColor="@color/green" android:layout_marginStart="8dp"/>
        <TextView android:id="@+id/tv_numero_prod" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="10sp"
            android:textColor="@color/muted" android:layout_marginStart="8dp"/>
    </LinearLayout>
</LinearLayout>
