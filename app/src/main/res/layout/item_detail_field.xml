<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="10dp"
    android:background="@color/paper" android:layout_marginBottom="4dp">
    <TextView android:id="@+id/field_label" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textSize="9sp"
        android:textColor="@color/muted" android:textAllCaps="true" android:letterSpacing="0.08"/>
    <TextView android:id="@+id/field_value" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textSize="14sp"
        android:textColor="@color/ink" android:layout_marginTop="2dp"/>
</LinearLayout>
