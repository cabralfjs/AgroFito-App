<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/cream">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@color/green_dark" android:padding="12dp"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/btn_back" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="←"
            android:textColor="#FFFFFF" android:textSize="20sp" android:padding="4dp"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="8dp">
            <TextView android:id="@+id/detail_titulo" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textColor="#FFFFFF"
                android:textSize="14sp" android:textStyle="bold"/>
            <TextView android:id="@+id/detail_estado" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textColor="#A8D96C"
                android:textSize="11sp" android:layout_marginTop="2dp"/>
        </LinearLayout>
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout android:id="@+id/detail_fields"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="12dp"/>
    </ScrollView>
</LinearLayout>
